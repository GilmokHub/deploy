# ==========================================
# OCI 배포 환경변수 명세서 (deploy/.env.example)
# 서버 배포 시 ~/deploy/.env 로 복사하여 사용합니다.
# ==========================================

# 1. 도메인 설정 (Dynu DDNS)
PLATFORM_DOMAIN=gilmok-platform.mywire.org
DEMO_DOMAIN=gilmok-demo.mywire.org
MONITORING_DOMAIN=gilmok-mon.mywire.org

# 2. 데이터베이스 설정
DB_PASSWORD=your_secure_db_password

# 3. Watchtower 무인 자동 배포 토큰 (deploy.yml의 WATCHTOWER_TOKEN과 동일해야 함)
WATCHTOWER_TOKEN=your_secure_watchtower_token_32_characters_random

# 4. 입장 토큰(JWT) 서명 및 오프라인 검증용 비밀키 (256비트 대칭키, VM 1/VM 2 동일)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length

# 5. Google Gemini AI 연동 설정 (VM 1 플랫폼 전용)
GEMINI_PROJECT_ID=your_gemini_project_id
GEMINI_API_KEY=your_gemini_api_key
