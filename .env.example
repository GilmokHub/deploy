# ==============================================================================
# OCI 배포 환경변수 명세서 (deploy/.env.example - Zero Fallback SSOT)
# 각 서버(VM 1, VM 2) 배포 시 ~/deploy/.env 로 복사하여 사용합니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 공통 인프라 설정
# ------------------------------------------------------------------------------
# 도메인 설정 (Dynu DDNS)
PLATFORM_DOMAIN=gilmok-platform.mywire.org
DEMO_DOMAIN=gilmok-demo.mywire.org
MONITORING_DOMAIN=gilmok-mon.mywire.org

# 데이터베이스 설정 (각 VM 독립 MySQL root 비밀번호)
DB_PASSWORD=your_secure_db_password

# Watchtower 무인 자동 배포 토큰 (GitHub Secrets의 WATCHTOWER_TOKEN과 100% 동일해야 함)
WATCHTOWER_TOKEN=your_secure_watchtower_token_32_characters_random

# ------------------------------------------------------------------------------
# 2. VM 1: 플랫폼(Platform) 전용 설정
# ------------------------------------------------------------------------------
# Google Gemini AI 연동 설정 (AI 정책 추천 기능)
GEMINI_PROJECT_ID=your_gemini_project_id
GEMINI_API_KEY=your_gemini_api_key

# JWT 비대칭키 (RS256 서명용 2048비트 RSA 키 페어, Base64 단일 라인 문자열)
# 발급 명령어:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl pkcs8 -topk8 -inform PEM -outform DER -in private.pem -nocrypt | base64 -w 0
#   openssl rsa -pubout -in private.pem -outform DER | base64 -w 0
PLATFORM_JWT_PRIVATE_KEY=your_base64_encoded_rsa_private_key_pkcs8_single_line
PLATFORM_JWT_PUBLIC_KEY=your_base64_encoded_rsa_public_key_x509_single_line

# B2B 플랫폼 관리자 인증 PassKey (X-Platform-Admin-Key 대조용)
PLATFORM_ADMIN_KEY_MASTER=gmk_master_prod_your_secure_token
PLATFORM_ADMIN_KEY_DEMO=gmk_demo_prod_your_secure_token

# 관측성 모니터링 Prometheus 주소 (VM 3 사설 IP)
PROMETHEUS_URL=http://10.0.0.132:9090

# ------------------------------------------------------------------------------
# 3. VM 2: 데모(Demo) 전용 설정
# ------------------------------------------------------------------------------
# 데모 회원 자체 로그인 토큰 서명용 비밀키 (HS256 대칭키, 최소 32자 이상)
JWT_SECRET=your_demo_auth_jwt_secret_minimum_256_bits_length

# 플랫폼 대기열 입장 토큰 검증용 JWKS 주소 (VM 1 사설 IP - 동일 VCN 초저지연 통신)
GILMOK_ADMISSION_JWKS_URI=http://10.0.0.250/gilmok-platform/.well-known/jwks.json
